# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/

# ── Virtual environments ───────────────────────────────────────────────────────
venv/
.venv/
env/
ENV/

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── IDE / OS ──────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.DS_Store
Thumbs.db
desktop.ini

# ── Large data archives (never commit raw zips) ───────────────────────────────
*.zip
*.tar.gz
*.tar.bz2
*.7z
*.rar

# ── Large binary / raster data ────────────────────────────────────────────────
*.tif
*.tiff
*.geotiff

# ── Raw / unprocessed datasets (too large for GitHub) ─────────────────────────
data/sensor_data/
data/combined/
data/dashcam_data/

# Vision dataset images + labels (708 MB — use DVC or external storage)
data/processed/vision/

# Video frames (use external storage)
data/processed/video/

# ── Large sensor CSVs (> 50 MB each) — keep only processed feature CSVs ───────
# Specifically exclude IVP raw CSVs
data/sensor_data/

# ── Keep these processed artefacts (small, important) ─────────────────────────
# data/processed/features/   ← KEEP (< 2 MB)
# data/processed/sensors/    ← KEEP (< 10 MB)

# ── Logs / temp ───────────────────────────────────────────────────────────────
*.log
*.tmp
.streamlit/secrets.toml
